# Platform-managed Zoho OAuth application. Never commit real values.
# Create a Server-based OAuth client in the Zoho API Console, enable Multi DC,
# allow the required regions, and register this exact callback:
# https://YOUR_API_HOST/api/v1/crm/zoho/one-click/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# A Multi-DC client can use a different secret in each region. Leave a regional
# value blank to use ZOHO_CLIENT_SECRET for that region.
ZOHO_CLIENT_SECRET_US=
ZOHO_CLIENT_SECRET_IN=
ZOHO_CLIENT_SECRET_EU=
ZOHO_CLIENT_SECRET_AU=
ZOHO_CLIENT_SECRET_JP=
ZOHO_CLIENT_SECRET_CA=
ZOHO_CLIENT_SECRET_CN=

# The normal Multi-DC authorization request starts at accounts.zoho.com. Zoho
# returns location and accounts-server; the callback validates those values and
# exchanges the code at the trusted regional endpoint automatically.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_API_VERSION=v8
ZOHO_OAUTH_SCOPES=ZohoCRM.modules.ALL,ZohoCRM.settings.ALL,ZohoCRM.org.READ

# Browser page that receives the safe OAuth completion result.
ZOHO_OAUTH_FRONTEND_URL=http://localhost:3100/integrations
# Set explicitly in staging/production; leave blank locally to derive from the API request.
ZOHO_OAUTH_REDIRECT_URI=

# Runs an actual Leads upsert and read-back after OAuth, with Zoho workflows suppressed.
ZOHO_LIVE_CERTIFICATION_ENABLED=true
