# Copy to .env for local Docker Compose use. Never commit real credentials.
APP_ENV=development
APP_AUTO_CREATE_SCHEMA=false
LOG_LEVEL=INFO
LOG_JSON=true

# Browser / API
APP_CORS_ORIGINS=["http://localhost:3100","http://127.0.0.1:3100","http://localhost:8100","http://127.0.0.1:8100"]
# Keep this relative in the Compose build so browser traffic uses Nginx.
VITE_API_URL=/api/v1
VITE_DEMO_MODE=false
# Space-separated, origin-only upload destinations baked into the admin CSP.
# This must include S3_PUBLIC_ENDPOINT_URL exactly or the web build fails.
# Rebuild the web image after changing either value.
WEB_CSP_EXTRA_CONNECT_SRC="http://localhost:9010 http://127.0.0.1:9010"
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3100
# Optional assigned ngrok domain, reused automatically by start.bat.
NGROK_DOMAIN=
API_BIND_ADDRESS=127.0.0.1
API_PORT=8100

# Authentication (replace every value outside local development)
JWT_SECRET=replace-with-at-least-32-random-characters
# Encrypts TOTP secrets at rest. Production requires a separate random value
# (32+ characters) that must not match JWT_SECRET.
MFA_ENCRYPTION_KEY=replace-with-a-distinct-32-character-random-mfa-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=northstar-api
JWT_AUDIENCE=northstar-web
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-before-first-run
SEED_ADMIN_NAME=Workspace Owner
SEED_TENANT_NAME=Northstar Workspace
SEED_DEMO_AGENT=true
ALLOW_PRODUCTION_SEED=false
# Platform control-plane access is separate from tenant/workspace roles.
# Keep empty to disable; configure only trusted operator emails.
PLATFORM_ADMIN_EMAILS=[]

# Account email and workspace invitations share SMTP. Use SMTP in production.
# Development may use log mode; production never logs raw verification,
# recovery, or invitation URLs.
EMAIL_DELIVERY_MODE=log
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Northstar
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:3100/verify-email
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_FRONTEND_URL=http://localhost:3100/reset-password
PASSWORD_RESET_TTL_MINUTES=60
WORKSPACE_INVITATION_FRONTEND_URL=http://localhost:3100/workspace-invitation
WORKSPACE_INVITATION_TTL_DAYS=7
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10

# Hosted subscription billing (optional). Leave blank to retain provider-less
# local/demo billing. Configure Stripe Price IDs for every self-service plan you
# want to sell, and point the Stripe webhook endpoint to:
#   https://YOUR_API/api/v1/billing/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3100/settings?billing=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3100/settings?billing=cancelled
STRIPE_PORTAL_RETURN_URL=http://localhost:3100/settings
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_TIMEOUT_SECONDS=10
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_WEBHOOK_MAX_BYTES=1048576

# NVIDIA. Obtain a newly rotated key; do not reuse a key pasted in chat.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_TEMPERATURE=1
NVIDIA_TOP_P=0.95
NVIDIA_MAX_TOKENS=16384
NVIDIA_ENABLE_THINKING=true
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_DIMENSION=2048

# Meta WhatsApp Cloud API / Embedded Signup v4. Keep secrets server-side.
# Create these in Meta App Dashboard; see docs/whatsapp.md.
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_CONFIGURATION_ID=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Generate an independent random value of at least 32 characters.
META_WHATSAPP_TOKEN_ENCRYPTION_KEY=
META_GRAPH_API_VERSION=v26.0
META_GRAPH_BASE_URL=https://graph.facebook.com
META_WEBHOOK_MAX_BYTES=1048576
META_SIGNUP_SESSION_TTL_SECONDS=600
WHATSAPP_DISPATCH_MAX_ATTEMPTS=8
CRM_CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-random-characters-for-crm

# One-click CRM integration. The customer never enters these platform OAuth
# application secrets. Register each callback URL with the provider as:
#   ${CRM_OAUTH_PUBLIC_BASE_URL}/api/v1/crm/oauth/<provider>/callback
# Supported provider path values: zoho, salesforce, hubspot, dynamics365,
# pipedrive. Local HTTP is permitted for development; production requires HTTPS.
CRM_OAUTH_PUBLIC_BASE_URL=http://localhost:8100
CRM_OAUTH_FRONTEND_ORIGIN=http://localhost:3100
CRM_ZOHO_CLIENT_ID=
CRM_ZOHO_CLIENT_SECRET=
CRM_SALESFORCE_CLIENT_ID=
CRM_SALESFORCE_CLIENT_SECRET=
CRM_HUBSPOT_CLIENT_ID=
CRM_HUBSPOT_CLIENT_SECRET=
CRM_DYNAMICS365_CLIENT_ID=
CRM_DYNAMICS365_CLIENT_SECRET=
CRM_PIPEDRIVE_CLIENT_ID=
CRM_PIPEDRIVE_CLIENT_SECRET=

# PostgreSQL / pgvector
POSTGRES_DB=northstar
POSTGRES_USER=northstar
POSTGRES_PASSWORD=replace-local-postgres-password
# Runtime/service role names are schema contracts; change their passwords and
# synchronized DSNs, not these names.
POSTGRES_RUNTIME_USER=northstar_app
POSTGRES_RUNTIME_PASSWORD=replace-local-postgres-runtime-password
POSTGRES_SERVICE_USER=northstar_service
POSTGRES_SERVICE_PASSWORD=replace-local-postgres-service-password
# Keep these DSNs synchronized with the role credentials above. URL-encode
# reserved password characters in DSNs while retaining the raw role passwords.
DATABASE_URL=postgresql+asyncpg://northstar_app:replace-local-postgres-runtime-password@postgres:5432/northstar
WORKER_DATABASE_URL=postgresql+asyncpg://northstar_service:replace-local-postgres-service-password@postgres:5432/northstar
MIGRATION_DATABASE_URL=postgresql+asyncpg://northstar:replace-local-postgres-password@postgres:5432/northstar
DATABASE_RUNTIME_ROLE=northstar_app
DATABASE_APPLY_RUNTIME_ROLE=true
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=55432

# Redis
REDIS_PASSWORD=replace-local-redis-password
REDIS_URL=redis://:replace-local-redis-password@redis:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=0.5
REDIS_SOCKET_TIMEOUT_SECONDS=1.0
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6399

# RabbitMQ / Celery
RABBITMQ_DEFAULT_USER=northstar
RABBITMQ_DEFAULT_PASS=replace-local-rabbitmq-password
RABBITMQ_DEFAULT_VHOST=northstar
RABBITMQ_URL=amqp://northstar:replace-local-rabbitmq-password@rabbitmq:5672/northstar
CELERY_CONCURRENCY=2
WHATSAPP_CELERY_CONCURRENCY=2
RABBITMQ_BIND_ADDRESS=127.0.0.1
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ENABLED=true
BACKGROUND_DISPATCH_ENABLED=true
EDUCATION_MULTI_COURSE_ENABLED=true
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_BIND_ADDRESS=127.0.0.1
KAFKA_HOST_PORT=29093

# S3-compatible document storage
MINIO_ROOT_USER=northstar
MINIO_ROOT_PASSWORD=replace-local-minio-password
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9010
S3_BUCKET=northstar-knowledge
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=northstar
S3_SECRET_ACCESS_KEY=replace-local-minio-password
S3_PRESIGN_TTL_SECONDS=900
UPLOAD_MAX_BYTES=524288000
KNOWLEDGE_MAX_EXTRACTED_CHARACTERS=2000000
KNOWLEDGE_MAX_CHUNKS=2000
KNOWLEDGE_MAX_PDF_PAGES=500
EXTRACTION_VISION_PROVIDER=nvidia
EXTRACTION_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
EXTRACTION_VISION_TIMEOUT_SECONDS=120
EXTRACTION_VISION_MAX_TOKENS=512
KNOWLEDGE_SITEMAP_MAX_URLS=25
KNOWLEDGE_MAX_DOCX_UNCOMPRESSED_BYTES=104857600
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_BROWSER_REDIRECT_URL=http://localhost:9011
# Community MinIO supports an explicit cluster-wide origin list (comma-separated).
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:3100,http://127.0.0.1:3100,http://localhost:8100

# Rate limiting and retrieval safety. Widget origins are configured per agent.
DEFAULT_RATE_LIMIT_PER_MINUTE=30
LOGIN_RATE_LIMIT_PER_MINUTE=8
LOGIN_GLOBAL_RATE_LIMIT_PER_MINUTE=120
LOGIN_HASH_CONCURRENCY=4
AGENT_GLOBAL_RATE_LIMIT_PER_MINUTE=120
WIDGET_SESSION_RATE_LIMIT_PER_MINUTE=60
MODEL_CONCURRENCY_PER_PROCESS=16
RATE_LIMIT_FAIL_OPEN=true
MAXIMUM_MESSAGE_CHARACTERS=12000
RETRIEVAL_CANDIDATE_LIMIT=40
RETRIEVAL_CONTEXT_LIMIT=8
RETRIEVAL_MIN_SCORE=0.20

# Local fallbacks. Set REQUIRE_NVIDIA=true and disable both fallbacks in production.
REQUIRE_NVIDIA=false
ALLOW_DETERMINISTIC_EMBEDDINGS=true

# Build and orchestration
COMPOSE_PROJECT_NAME=northstar-ai
IMAGE_TAG=local

# Help Center
HELP_CONTENT_SYNC_ON_STARTUP=true
HELP_SEARCH_PAGE_SIZE_MAX=50
HELP_SEARCH_CANDIDATE_LIMIT=40
HELP_AI_RATE_LIMIT_PER_MINUTE=12
HELP_AI_MIN_SCORE=0.12

# Platform-owned Telegram manager (backend only). See docs/telegram-managed-bots.md.
TELEGRAM_MANAGER_BOT_TOKEN=
TELEGRAM_MANAGER_BOT_USERNAME=
TELEGRAM_MANAGER_WEBHOOK_SECRET=
TELEGRAM_PUBLIC_BASE_URL=
TELEGRAM_NGROK_API_URL=http://host.docker.internal:4040/api/tunnels
TELEGRAM_NGROK_TUNNEL_PORT=3100

