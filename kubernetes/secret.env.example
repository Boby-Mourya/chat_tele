JWT_SECRET=replace-with-generated-secret
DATABASE_URL=postgresql+asyncpg://runtime-user:password@postgres.example:5432/northstar
MIGRATION_DATABASE_URL=postgresql+asyncpg://schema-owner:password@postgres.example:5432/northstar
WORKER_DATABASE_URL=postgresql+asyncpg://service-user:password@postgres.example:5432/northstar
REDIS_URL=rediss://user:password@redis.example:6379/0
RABBITMQ_URL=amqps://user:password@rabbitmq.example:5671/northstar
NVIDIA_API_KEY=replace-with-rotated-key
S3_ACCESS_KEY_ID=replace-with-workload-identity-or-key
S3_SECRET_ACCESS_KEY=replace-with-workload-identity-or-secret
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret
META_WHATSAPP_CONFIGURATION_ID=replace-with-configuration-id
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-generated-token
META_WHATSAPP_TOKEN_ENCRYPTION_KEY=replace-with-generated-key
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
