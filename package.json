{
  "name": "northstar-ai-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @northstar/web",
    "build": "npm run build --workspace @northstar/web",
    "lint": "npm run lint --workspace @northstar/web",
    "test": "npm run test --workspace @northstar/web",
    "typecheck": "npm run typecheck --workspace @northstar/web",
    "api:dev": "uv run --project backend uvicorn northstar_api.main:app --reload --host 0.0.0.0 --port 8000",
    "api:lint": "uv run --project backend ruff check backend",
    "api:test": "uv run --project backend pytest -c backend/pyproject.toml backend/tests",
    "api:typecheck": "uv run --project backend mypy --config-file backend/pyproject.toml backend/src",
    "compose:config": "docker compose config --quiet",
    "compose:up": "docker compose up --build -d",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f --tail=200"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
