APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_AUTO_CREATE_SCHEMA=false
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# The raw role settings initialize root Compose only; the API consumes the
# separate DSNs below. Keep all three credentials distinct. The runtime and
# service role names are fixed migration/worker contracts.
POSTGRES_DB=northstar
POSTGRES_USER=northstar
POSTGRES_PASSWORD=replace-local-postgres-password
POSTGRES_RUNTIME_USER=northstar_app
POSTGRES_RUNTIME_PASSWORD=replace-local-postgres-runtime-password
POSTGRES_SERVICE_USER=northstar_service
POSTGRES_SERVICE_PASSWORD=replace-local-postgres-service-password
DATABASE_URL=postgresql+asyncpg://northstar_app:replace-local-postgres-runtime-password@localhost:5432/northstar
WORKER_DATABASE_URL=postgresql+asyncpg://northstar_service:replace-local-postgres-service-password@localhost:5432/northstar
MIGRATION_DATABASE_URL=postgresql+asyncpg://northstar:replace-local-postgres-password@localhost:5432/northstar
DATABASE_RUNTIME_ROLE=northstar_app
DATABASE_APPLY_RUNTIME_ROLE=true
REDIS_URL=redis://:replace-local-redis-password@localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=0.5
REDIS_SOCKET_TIMEOUT_SECONDS=1.0
RABBITMQ_URL=amqp://northstar:replace-local-rabbitmq-password@localhost:5672/northstar
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_ENABLED=false
BACKGROUND_DISPATCH_ENABLED=false

S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=northstar-knowledge
S3_ACCESS_KEY_ID=northstar
S3_SECRET_ACCESS_KEY=replace-local-minio-password
S3_PRESIGN_TTL_SECONDS=900
UPLOAD_MAX_BYTES=524288000
KNOWLEDGE_MAX_EXTRACTED_CHARACTERS=2000000
KNOWLEDGE_MAX_CHUNKS=2000
KNOWLEDGE_MAX_PDF_PAGES=500
EXTRACTION_VISION_PROVIDER=nvidia
EXTRACTION_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
EXTRACTION_VISION_TIMEOUT_SECONDS=120
EXTRACTION_VISION_MAX_TOKENS=512
EXTRACTION_RENDER_DPI=300
EXTRACTION_MAX_IMAGE_PIXELS=12000000
EXTRACTION_MAX_CALLS_PER_PAGE=96
EXTRACTION_REGION_RETRIES=3
EXTRACTION_PAGE_TIMEOUT_SECONDS=450
EXTRACTION_PAGES_PER_TASK=2
EXTRACTION_MAX_EVIDENCE_BYTES=536870912
EXTRACTION_WORD_RENDERER=soffice
EXTRACTION_WORD_TIMEOUT_SECONDS=120
KNOWLEDGE_SITEMAP_MAX_URLS=25
KNOWLEDGE_MAX_DOCX_UNCOMPRESSED_BYTES=104857600

# Generate independent long random values. Production requires MFA_ENCRYPTION_KEY
# and rejects it when it matches JWT_SECRET or contains placeholder text.
JWT_SECRET=change-me-to-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-a-distinct-32-character-random-mfa-secret
# Encrypts user-configured LLM provider API keys at rest. Use a distinct
# production secret and keep it server-side; it is never sent to the browser.
CRM_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-distinct-32-character-llm-credential-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=northstar-api
JWT_AUDIENCE=northstar-web
JWT_ACCESS_TTL_MINUTES=30
PLATFORM_IMPERSONATION_TTL_MINUTES=15
# Comma-separated platform-owner accounts. Optional JSON permissions can narrow
# each account; omit it to preserve full access for the allowlisted accounts.
PLATFORM_ADMIN_EMAILS=
PLATFORM_ADMIN_PERMISSIONS={}
JWT_REFRESH_TTL_DAYS=14

# Account email and workspace invitations share the SMTP transport. Development
# may use log mode; production must configure SMTP and never logs raw verification,
# recovery, or invitation links.
EMAIL_DELIVERY_MODE=log
EMAIL_FROM_ADDRESS=no-reply@northstar.local
EMAIL_FROM_NAME=Northstar
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:5173/verify-email
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password
PASSWORD_RESET_TTL_MINUTES=60
WORKSPACE_INVITATION_FRONTEND_URL=http://localhost:5173/workspace-invitation
WORKSPACE_INVITATION_TTL_DAYS=7
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10

# Server-side only. Never expose this value through Vite/Next public variables.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_TEMPERATURE=1
NVIDIA_TOP_P=0.95
NVIDIA_MAX_TOKENS=16384
NVIDIA_ENABLE_THINKING=true
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_DIMENSION=2048
REQUIRE_NVIDIA=false
ALLOW_DETERMINISTIC_EMBEDDINGS=true

# Meta WhatsApp Cloud API / Embedded Signup v4. Never expose the secret,
# verification token, token-encryption key, or customer access token to a browser.
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_CONFIGURATION_ID=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_TOKEN_ENCRYPTION_KEY=
META_GRAPH_API_VERSION=v26.0
META_GRAPH_BASE_URL=https://graph.facebook.com
META_WEBHOOK_MAX_BYTES=1048576
META_SIGNUP_SESSION_TTL_SECONDS=600
WHATSAPP_DISPATCH_MAX_ATTEMPTS=8

RATE_LIMIT_FAIL_OPEN=true
DEFAULT_RATE_LIMIT_PER_MINUTE=30
LOGIN_RATE_LIMIT_PER_MINUTE=8
LOGIN_GLOBAL_RATE_LIMIT_PER_MINUTE=120
LOGIN_HASH_CONCURRENCY=4
AGENT_GLOBAL_RATE_LIMIT_PER_MINUTE=120
WIDGET_SESSION_RATE_LIMIT_PER_MINUTE=60
MODEL_CONCURRENCY_PER_PROCESS=16
MAXIMUM_MESSAGE_CHARACTERS=12000
RETRIEVAL_CANDIDATE_LIMIT=40
RETRIEVAL_CONTEXT_LIMIT=8
RETRIEVAL_MIN_SCORE=0.20
LOG_LEVEL=INFO
LOG_JSON=true

# Optional, explicit one-time bootstrap. No credentials are built into the image.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Workspace Owner
SEED_TENANT_NAME=Northstar Workspace
SEED_DEMO_AGENT=false
ALLOW_PRODUCTION_SEED=false

# Help Center
HELP_CONTENT_SYNC_ON_STARTUP=true
HELP_SEARCH_PAGE_SIZE_MAX=50
HELP_SEARCH_CANDIDATE_LIMIT=40
HELP_AI_RATE_LIMIT_PER_MINUTE=12
HELP_AI_MIN_SCORE=0.12
